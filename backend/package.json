{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:test": "wrangler deploy --env test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply groupware-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply groupware-db --remote",
    "db:migrate:test": "wrangler d1 migrations apply groupware-db-test --remote --env test",
    "db:seed:local": "wrangler d1 execute groupware-db --local --file=./seed.sql",
    "db:seed:test": "wrangler d1 execute groupware-db-test --remote --env test --file=./seed.sql",
    "db:studio:local": "wrangler d1 execute groupware-db --local --command \"SELECT name FROM sqlite_master WHERE type='table'\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.121.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true
  }
